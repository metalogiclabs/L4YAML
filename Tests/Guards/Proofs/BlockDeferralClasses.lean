#guard pins "?\n  ?\n    ? -\n  : v\n: w\n" == ("scan-accepted", "+STR +DOC +MAP +MAP +MAP +SEQ =VAL : -SEQ =VAL : -MAP =VAL :v -MAP =VAL :w -MAP -DOC -STR")
