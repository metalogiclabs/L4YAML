#guard pins "?\n  ? -\n: w\n" == ("scan-accepted", "+STR +DOC +MAP +MAP +SEQ =VAL : -SEQ =VAL : -MAP =VAL :w -MAP -DOC -STR")
#guard pins "?\n  ? - a\n: w\n" == ("scan-accepted", "+STR +DOC +MAP +MAP +SEQ =VAL :a -SEQ =VAL : -MAP =VAL :w -MAP -DOC -STR")
