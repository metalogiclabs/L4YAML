-- The other two indicators off the same park, which never read the register.
#guard pins "- a\n" == ("scan-accepted", "+STR +DOC +SEQ =VAL :a -SEQ -DOC -STR")
#guard pins "? a\n" == ("scan-accepted", "+STR +DOC +MAP =VAL :a =VAL : -MAP -DOC -STR")

