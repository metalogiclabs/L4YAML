#guard pins ": b\n" == ("scan-accepted", "+STR +DOC +MAP =VAL : =VAL :b -MAP -DOC -STR")
#guard pins ":\n" == ("scan-accepted", "+STR +DOC +MAP =VAL : =VAL : -MAP -DOC -STR")
