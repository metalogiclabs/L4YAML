#guard pins "?\n  ?\n    ? - a\n  : v\n: w\n" == ("scan-accepted", "+STR +DOC +MAP +MAP +MAP +SEQ =VAL :a -SEQ =VAL : -MAP =VAL :v -MAP =VAL :w -MAP -DOC -STR")

