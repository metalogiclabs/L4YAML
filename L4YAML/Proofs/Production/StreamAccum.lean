  split at hok
  · rename_i h_eq; exact absurd h_eq (by decide)
  · split at hok
    · rename_i h_eq; exact absurd h_eq (by decide)
    · split at hok
      · rename_i h_eq; exact absurd h_eq (by decide)
      · split at hok
        · rename_i h_eq; exact absurd h_eq (by decide)
        · split at hok
          · rename_i h_eq; exact absurd h_eq (by decide)
          · split at hok
            · split at hok
              · simp at hok
              · rename_i s_sq hsq
                have h := Except.ok.inj hok; subst h
