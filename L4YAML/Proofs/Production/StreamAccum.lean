      (∀ sp_mid : SurfPos, SSLComments sp' sp_mid →
        (∀ n, n ≤ d → SCLLiteral n sp sp_mid) ∨ (∀ n, n ≤ d → SCLFolded n sp sp_mid)) := by
  cases hchar with
  | inl h_lit =>
    subst h_lit
