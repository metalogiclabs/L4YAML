              | Or.inl ⟨ks, h_lt, h_cvS, closeF⟩ => Or.inl ⟨ks, h_lt,
                  h_cvS.imp (fun ⟨lo, hb, hc⟩ => ⟨lo, hb, h_cov_step lo ks hc⟩) id,
