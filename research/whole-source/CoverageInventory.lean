      match ci with
      | .inductInfo info =>
        actual := n :: actual
        actualCtors := info.ctors ++ actualCtors
      | _ => pure ()
  unless actual.length == expected.length && actual.all expected.contains && expected.all actual.contains do
    throwError "SURFACE INVENTORY DRIFT: {actual}"
  unless actualCtors.length == expectedCtors.length && actualCtors.all expectedCtors.contains && expectedCtors.all actualCtors.contains do
    throwError "SURFACE CONSTRUCTOR DRIFT: {actualCtors}"
  logInfo m!"COMPILED_SURFACE_CENSUS inductives={actual.length} constructors={actualCtors.length}; semantic coverage UNKNOWN"
