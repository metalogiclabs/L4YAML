+        hok h_nf hek hsk).2
+      have hcur : (s.col : Int) = (scanValueClearKey s).explicitKeyCol := by omega
+      simp [scanValueKeySurvives, h_nf, hekl, hek, hsk, hcur]
+  exact r2_closed_value_excludes_column hok hs h_nf hclose (hkc.trans heq) hn
