+run_cmd do
+  let env ← Lean.getEnv
+  let some ctor := env.find? `L4YAML.Proofs.StreamAccum.PendingNode.pendingBlock
+    | throwError "missing pending-block constructor"
+  let mut cursor := ctor.type
+  let mut stored := false
+  while let .forallE name domain body _ := cursor do
+    if name == `h_close_entry && domain.getUsedConstants.contains
+        `L4YAML.Proofs.R2ConsumptionClosure.EntryValues then stored := true
+    cursor := body
+  unless stored do throwError "sequence continuation was not stored in its actual field"
+  let some consumer := env.find? `L4YAML.Proofs.StreamAccum.accum_block_on_pendingBlock
+    | throwError "missing pending-block consumer"
+  let some body := consumer.value? (allowOpaque := true)
+    | throwError "pending-block consumer has no body"
+  for required in [`L4YAML.Proofs.R2SequenceContext.SequenceValues.slot,
+      `L4YAML.Proofs.R2SequenceContext.SequenceValues.sibling,
+      `L4YAML.Proofs.R2SequenceContext.SequenceValues.nested,
+      `L4YAML.Proofs.R2SequenceContext.SequenceValues.compact] do
+    unless body.getUsedConstants.contains required do
+      throwError "pending-block consumer did not spend {required}"
+  let mut parameterCursor := consumer.type
+  while let .forallE name _ tail _ := parameterCursor do
+    if name == `h_sequenceContext || name == `h_slotValues then
+      throwError "external context premise added to the consumer"
+    parameterCursor := tail
+  Lean.logInfo "SEQUENCE-CONTEXT-AUDIT stored=h_close_entry consumers=4/4 new_external_context=absent"
