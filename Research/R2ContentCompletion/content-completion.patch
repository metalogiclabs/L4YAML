+      [`L4YAML.Proofs.R2ContentCompletion.CompletedValues.sibling])]
+  for (name, readers) in rows do
+    let some ci := env.find? name | throwError "missing actual reader"
+    let some body := ci.value? (allowOpaque := true) | throwError "missing actual reader body"
+    for reader in readers do
+      unless body.getUsedConstants.contains reader do throwError "{name} omits {reader}"
+    let mut parameterCursor := ci.type
+    while let .forallE name _ tail _ := parameterCursor do
+      if name == `h_completedContext || name == `h_sequenceContext then
+        throwError "new external context premise on an actual reader"
+      parameterCursor := tail
+  let axioms ← Lean.collectAxioms `L4YAML.Proofs.StreamAccum.accum_content_on_pendingBlock_indented
+  if axioms.contains `sorryAx then throwError "ordinary completion producer contains sorryAx"
+  Lean.logInfo "COMPLETION-CONTEXT-AUDIT stored=2 readers=5/5 new_external_context=absent ordinary_sorryAx=absent"
